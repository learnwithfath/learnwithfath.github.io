{
  "name": "my-learning-platform",
  "version": "1.0.0",
  "description": "Interactive learning platform using Google Codelabs",
  "scripts": {
    "serve": "./serve.sh",
    "stop": "./stop.sh",
    "new": "./new-codelab.sh",
    "export": "node scripts/export-codelabs.mjs",
    "export:single": "cd codelabs && go run github.com/googlecodelabs/tools/claat@latest export",
    "validate:roadmap": "node scripts/validate-agentic-roadmap.mjs",
    "generate:labs": "node scripts/generate-agentic-labs.mjs",
    "validate:labs": "node scripts/validate-agentic-labs.mjs",
    "build": "npm run export && npm run validate:roadmap && npm run validate:labs",
    "dev": "npm run serve"
  },
  "keywords": [
    "codelabs",
    "learning",
    "tutorial",
    "education",
    "interactive"
  ],
  "author": "Your Name",
  "license": "MIT"
}
